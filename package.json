{
  "name": "n8n-nodes-capslane",
  "version": "0.1.0",
  "description": "Official n8n community node for Capslane YouTube transcripts",
  "type": "module",
  "license": "MIT",
  "files": ["dist", "workflows", "README.md", "LICENSE"],
  "scripts": { "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs", "test": "node --test test/*.test.mjs" },
  "publishConfig": { "access": "public", "provenance": true },
  "repository": { "type": "git", "url": "https://github.com/WebbaLuca/n8n-nodes-capslane.git" },
  "keywords": ["n8n-community-node-package", "youtube", "transcript", "captions", "automation"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/CapslaneApi.credentials.js"],
    "nodes": ["dist/nodes/Capslane/Capslane.node.js"]
  },
  "peerDependencies": { "n8n-workflow": ">=2.0.0" },
  "peerDependenciesMeta": { "n8n-workflow": { "optional": true } },
  "devDependencies": { "typescript": "5.9.3" }
}
